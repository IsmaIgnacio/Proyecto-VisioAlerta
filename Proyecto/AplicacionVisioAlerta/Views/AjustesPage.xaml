<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AplicacionVisioAlerta.ViewModels"
             x:Class="AplicacionVisioAlerta.Views.AjustesPage"
             BackgroundColor="#1B3964"
             Title="Ajustes">

    <ContentPage.BindingContext>
        <vm:AjustesViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20" Spacing="20">
        <Label Text="Ajustes" FontSize="32" FontAttributes="Bold" TextColor="White" HorizontalOptions="Start" />
        <Label Text="Personaliza tu experiencia" TextColor="LightGray" Margin="0,-15,0,20" />

        <Frame BackgroundColor="White" CornerRadius="15" HasShadow="True" Padding="20">
            <VerticalStackLayout Spacing="10">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="📏" FontSize="20"/>
                    <Label Text="Distancia de detección" TextColor="#1B3964" FontAttributes="Bold" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <Grid ColumnDefinitions="*, Auto">
                    <Slider Grid.Column="0" Minimum="10" Maximum="200" 
                            Value="{Binding Distancia}" 
                            MinimumTrackColor="#2ECC71" />
                    <Frame Grid.Column="1" BackgroundColor="#1B3964" Padding="10,5" CornerRadius="8">
                        <Label Text="{Binding Distancia, StringFormat='{0:F0} cm'}" TextColor="White" FontAttributes="Bold"/>
                    </Frame>
                </Grid>
                <Label Text="Ajusta la distancia a la que se detectarán los obstáculos" FontSize="12" TextColor="Gray"/>
            </VerticalStackLayout>
        </Frame>

        <Frame BackgroundColor="White" CornerRadius="15" HasShadow="True" Padding="20">
            <VerticalStackLayout Spacing="15">
                <Label Text="Tipo de alerta" TextColor="#1B3964" FontAttributes="Bold"/>
                <Frame BorderColor="#2ECC71" BackgroundColor="Transparent" Padding="10" CornerRadius="10">
                    <HorizontalStackLayout Spacing="15">
                        <CheckBox IsChecked="{Binding VibracionOk}" Color="#2ECC71" />
                        <Label Text="📳 Vibración" VerticalOptions="Center" TextColor="#1B3964" />
                    </HorizontalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </Frame>

        <Button Text="Guardar cambios" 
                Command="{Binding GuardarCambiosCommand}"
                BackgroundColor="#2ECC71" 
                TextColor="White" 
                FontAttributes="Bold"
                HeightRequest="60"
                CornerRadius="15"
                VerticalOptions="EndAndExpand" />
    </VerticalStackLayout>
</ContentPage>