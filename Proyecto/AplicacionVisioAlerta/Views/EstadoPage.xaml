<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AplicacionVisioAlerta.ViewModels"
             x:Class="AplicacionVisioAlerta.Views.EstadoPage"
             Title="Estado">

    <ContentPage.BindingContext>
        <vm:EstadoViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20" Spacing="25" BackgroundColor="#F5F5F5">

        <Label Text="VisioAlerta" FontSize="32" FontAttributes="Bold" TextColor="#1B3964" />
        <Label Text="Sistema de detección inteligente" Margin="0,-20,0,0" TextColor="Gray" />

        <Frame CornerRadius="15" HasShadow="True" Padding="20" BackgroundColor="White">
            <VerticalStackLayout Spacing="15">
                <HorizontalStackLayout Spacing="15">
                    <Label Text="📶" FontSize="20"/>
                    <VerticalStackLayout>
                        <Label Text="WiFi" FontAttributes="Bold" TextColor="#1B3964"/>
                        <Label Text="Conectado - Monitoreo remoto" FontSize="12" TextColor="#2ECC71"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <BoxView HeightRequest="1" Color="#EEEEEE" />

                <HorizontalStackLayout Spacing="15" HorizontalOptions="FillAndExpand">
                    <Label Text="🔋" FontSize="20"/>
                    <Label Text="Nivel de batería" VerticalOptions="Center" TextColor="#1B3964"/>
                    <Label Text="{Binding Bateria, StringFormat='{0}%'}" 
                           FontAttributes="Bold" TextColor="#2ECC71" 
                           HorizontalOptions="EndAndExpand" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <ProgressBar Progress="0.85" ProgressColor="#2ECC71" />
            </VerticalStackLayout>
        </Frame>

        <Button Text="{Binding TextoBoton}"
                Command="{Binding AlternarSensoresCommand}"
                BackgroundColor="{Binding ColorBoton}"
                TextColor="White"
                HeightRequest="200"
                WidthRequest="200"
                CornerRadius="100"
                FontSize="18"
                FontAttributes="Bold"
                VerticalOptions="CenterAndExpand"
                HorizontalOptions="Center">
            <Button.Shadow>
                <Shadow Brush="Black" Offset="0,10" Radius="10" Opacity="0.2" />
            </Button.Shadow>
        </Button>

    </VerticalStackLayout>
</ContentPage>